# ---------------------------------------------------------------------------
# Nouri mobile app. EXPO_PUBLIC_* values are inlined into the JS bundle at build
# time, so everything here is PUBLIC by definition. Never put a secret in this
# file — API keys for USDA and Open Food Facts live on the backend.
#
# Supabase and the API must point at the SAME world: both local, or both
# deployed. App.tsx checks this at startup in development and complains loudly
# if they disagree, because the symptom otherwise is unexplained 401s.
# ---------------------------------------------------------------------------

# ---- Deployed -------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
EXPO_PUBLIC_API_BASE_URL=https://your-nouri-api.example.run.app

# ---- Local development ----------------------------------------------------
# Run `supabase start` in ../nouri-api, then `pnpm start:local` for the API.
# `supabase status -o env` prints the publishable key.
#
# The host to use depends on where the app is running. There is no single value
# that works everywhere, which is why this is configuration and not a constant:
#
#   iOS Simulator      shares the host's network namespace
#     EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#     EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
#
#   Android Emulator   127.0.0.1 is the emulator itself; 10.0.2.2 is the host
#     EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
#     EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
#
#   Physical device / Expo Go   must reach the machine over the LAN. Find the
#   address with `ipconfig getifaddr en0` (macOS). Do NOT commit it — it changes
#   per network and per developer.
#     EXPO_PUBLIC_SUPABASE_URL=http://<your-lan-ip>:54321
#     EXPO_PUBLIC_API_BASE_URL=http://<your-lan-ip>:8080
#
# For a physical device the API must also listen on the LAN, not just loopback:
# HOST=0.0.0.0 is already the default in nouri-api.
