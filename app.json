{
  "expo": {
    "name": "Nouri",
    "slug": "dribsnis",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./nouri_app_assets/assets/images/icon.png",
    "scheme": "dribsnis",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./nouri_app_assets/assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#21112E"
    },
    "ios": {
      "icon": "./nouri_app_assets/assets/images/ios-icon.png",
      "bundleIdentifier": "com.dribsnis.app",
      "supportsTablet": true
    },
    "android": {
      "icon": "./nouri_app_assets/assets/images/android-icon.png",
      "package": "com.dribsnis.app",
      "adaptiveIcon": {
        "foregroundImage": "./nouri_app_assets/assets/images/adaptive-icon.png",
        "backgroundImage": "./nouri_app_assets/assets/images/adaptive-background.png",
        "monochromeImage": "./nouri_app_assets/assets/images/monochrome-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./nouri_app_assets/assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./nouri_app_assets/assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#21112E",
          "imageWidth": 200
        }
      ],
      "expo-camera",
      "expo-font",
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
