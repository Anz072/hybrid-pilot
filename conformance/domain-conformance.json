{
  "version": 1,
  "description": "Conformance corpus for domain logic implemented independently in the React Native app and in nouri-api. Inputs and expected outputs only: no framework types, no HTTP, no database. Both repositories run these cases against their own implementation, so the two cannot drift apart while both test suites stay green.",
  "notes": [
    "Expected values encode the CURRENT agreed product contract, not an independent proof of correctness. A case exists to stop the two sides diverging; changing one deliberately means changing the fixture, which makes the change visible in review.",
    "Rounding follows JavaScript Math.round: halves go toward positive infinity, so 2.5 -> 3 and -2.5 -> -2. Cases below pin that explicitly.",
    "Time-of-day cases are fixed to UTC so both runtimes can evaluate them without a timezone argument the mobile helper does not take."
  ],
  "suites": {
    "roundNutrient": [
      {
        "name": "integer is unchanged",
        "input": {
          "value": 5,
          "places": 1
        },
        "expected": 5
      },
      {
        "name": "one decimal place by default",
        "input": {
          "value": 1.24,
          "places": 1
        },
        "expected": 1.2
      },
      {
        "name": "rounds up at the half",
        "input": {
          "value": 1.25,
          "places": 1
        },
        "expected": 1.3
      },
      {
        "name": "half rounds toward positive infinity",
        "input": {
          "value": 2.5,
          "places": 0
        },
        "expected": 3
      },
      {
        "name": "negative half also rounds toward positive infinity",
        "input": {
          "value": -2.5,
          "places": 0
        },
        "expected": -2
      },
      {
        "name": "negative one-decimal half",
        "input": {
          "value": -1.25,
          "places": 1
        },
        "expected": -1.2
      },
      {
        "name": "zero",
        "input": {
          "value": 0,
          "places": 1
        },
        "expected": 0
      },
      {
        "name": "zero places truncates to integer",
        "input": {
          "value": 123.6,
          "places": 0
        },
        "expected": 124
      },
      {
        "name": "very small value collapses to zero at one place",
        "input": {
          "value": 0.04,
          "places": 1
        },
        "expected": 0
      },
      {
        "name": "very small value survives at two places",
        "input": {
          "value": 0.04,
          "places": 2
        },
        "expected": 0.04
      },
      {
        "name": "large value",
        "input": {
          "value": 123456.789,
          "places": 1
        },
        "expected": 123456.8
      }
    ],
    "getFoodResolvedServing": [
