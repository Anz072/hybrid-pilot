      },
      {
        "name": "an explicit serving size wins",
        "input": {
          "nutritionBasis": "100g",
          "servingSizeValue": 30,
          "servingSizeUnit": "g"
        },
        "expected": {
          "value": 30,
          "unit": "g"
        }
      },
      {
        "name": "a decimal serving size is kept",
        "input": {
          "nutritionBasis": "100g",
          "servingSizeValue": 12.5,
          "servingSizeUnit": "g"
        },
        "expected": {
          "value": 12.5,
          "unit": "g"
        }
      },
      {
        "name": "zero serving size is not a serving size",
        "input": {
          "nutritionBasis": "100g",
          "servingSizeValue": 0,
          "servingSizeUnit": "g"
        },
        "expected": {
          "value": 100,
          "unit": "g"
        }
      },
      {
        "name": "negative serving size falls back",
        "input": {
          "nutritionBasis": "100g",
          "servingSizeValue": -5,
          "servingSizeUnit": "g"
        },
        "expected": {
          "value": 100,
          "unit": "g"
        }
      },
      {
        "name": "blank unit falls back to the basis unit",
        "input": {
          "nutritionBasis": "100ml",
          "servingSizeValue": 250,
          "servingSizeUnit": "   "
        },
        "expected": {
          "value": 250,
          "unit": "ml"
        }
      },
      {
        "name": "unit is trimmed",
        "input": {
          "nutritionBasis": "100g",
          "servingSizeValue": 30,
          "servingSizeUnit": "  slice "
        },
        "expected": {
          "value": 30,
          "unit": "slice"
        }
      },
      {
        "name": "an unknown basis degrades to per-100g",
        "input": {
          "nutritionBasis": "per_bottle",
          "servingSizeValue": null,
          "servingSizeUnit": null
        },
        "expected": {
          "value": 100,
          "unit": "g"
        }
      }
    ],
